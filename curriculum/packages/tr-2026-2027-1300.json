{"id":"tr-2026-2027-1300","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1300","gradeId":"12","programId":"program-1300","metadata":{"egitim_yili":"2026-2027","sinif":"12","ders":"Üç Boyutlu Sanat Atölye","grup":"Kültür Dersleri","brans":"Güzel Sanatlar Lisesi","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/guzel-sanatlar-lisesi/1300/uc-boyutlu-sanat-atolye-12"},"units":[{"id":"u1","name":"ÜÇ BOYUTLU SANATA GİRİŞ"},{"id":"u2","name":"MODELAJ"},{"id":"u3","name":"BÜST"},{"id":"u4","name":"Dönem Ara Tatili"},{"id":"u5","name":"HEYKEL UYGULAMALARI"},{"id":"u6","name":"RÖLYEF SANATI"},{"id":"u7","name":"Yarıyıl Tatili"},{"id":"u8","name":"SERAMİK SANATI"},{"id":"u9","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"1.1.1\nÜç boyutlu sanatı açıklar.\n1.1.2\nSanatın üç boyutlu sanattaki yerini açıklar."},{"id":"o2","unitId":"u1","text":"1.1.3\nÜç boyutlu kompozisyonun ilke ve elemanlarını açıklar.\n1.1.4\nÜç boyutlu biçimlendirme yöntem ve tekniklerini açıklar."},{"id":"o3","unitId":"u2","text":"2.1.1\nModelajı tanımlar.\n2.1.2\nModle ve modelajı ayırt eder.\n2.2.1\nModelaj tekniğinde kullanılan malzeme çeşitlerini açıklar."},{"id":"o4","unitId":"u2","text":"2.2.2\nModelaj tekniğiyle biçimlendirmede kullanılan araç gereçleri listeler.\n2.2.3\nDoğal formu ile plastik formu ayırt eder.\n2.2.4\nModelaj tekniğiyle form uygulamaları yapar."},{"id":"o5","unitId":"u3","text":"3.1.1\nBüstü tanımlar.\n3.1.2\nBaşın anatomik özelliklerini açıklar."},{"id":"o6","unitId":"u3","text":"3.1.3\nBüst çalışması için modelleme iskeleti yapar."},{"id":"o7","unitId":"u3","text":"3.1.4\nBüst çalışması yapar."},{"id":"o8","unitId":"u3","text":"3.2.1\nBüstte kalıp alma yöntem ve tekniklerini açıklar."},{"id":"o9","unitId":"u3","text":"3.3.1\nBüstte pozitif döküm tekniğini açıklar."},{"id":"o10","unitId":"u4","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u5","text":"4.1.1\nİnsan anatomisini açıklar.\n4.1.2\nHeykel çalışmasında figür formunu belirler."},{"id":"o12","unitId":"u5","text":"4.1.3\nYapacağı heykelin iskeletini hazırlar."},{"id":"o13","unitId":"u5","text":"4.1.4\nModelasyon yöntemiyle heykel çalışması yapar."},{"id":"o14","unitId":"u5","text":"4.1.5\nTamamladığı modelajın negatif kalıbını alır."},{"id":"o15","unitId":"u5","text":"4.1.6\nPozitif döküm yapar."},{"id":"o16","unitId":"u5","text":"4.1.7\nRötuş, temizlik, boyama ve patine işlemlerini yapar."},{"id":"o17","unitId":"u5","text":"4.1.8\nAtatürk heykeli çalışması sanatçıları açıklar."},{"id":"o18","unitId":"u6","text":"5.1.1\nRölyefi tanımlar.\n5.1.2\nRölyef ve heykel arasındaki farkı ayırt eder."},{"id":"o19","unitId":"u6","text":"5.1.5\nIşık ve gölgenin yüzey üzerindeki etkisini ayırt eder.\n5.2.1\nRölyefte uygulama ve malzeme türüne göre kullanılan araç gereçleri açıklar."},{"id":"o20","unitId":"u7","text":"Yarıyıl Tatili"},{"id":"o21","unitId":"u6","text":"5.2.2\nYatay ve dikey yüzeylerde rölyef altlığı hazırlama teknik ve yöntemlerini ayırt eder.\n5.2.3\nRölyef çalışmaları yapar."},{"id":"o22","unitId":"u6","text":"5.3.1\nRölyef çalışmalarında kompozisyon ilke ve elemanlarını kullanır.\n5.3.2\nRölyef-mekân ilişkisini açıklar."},{"id":"o23","unitId":"u6","text":"5.4.1\nNesneden hareketle rölyef çalışmaları yapar.\n5.4.2\nFigürden hareketle rölyef çalışmaları yapar."},{"id":"o24","unitId":"u6","text":"5.5.1\nRölyefte biçim bozma ve sadeleşme yöntemlerini açıklar.\n5.5.2\nBiçim bozma ve sadeleştirme yöntemleriyle rölyef çalışmaları yapar."},{"id":"o25","unitId":"u4","text":"2. Dönem Ara Tatili"},{"id":"o26","unitId":"u6","text":"5.6.1\nSoyut formlardan oluşan rölyef çalışmaları yapar.\n5.7.1\nKalıp almada kullanılacak araç gereçleri açıklar."},{"id":"o27","unitId":"u6","text":"5.7.2\nRölyefte açıyla kalıp alma işlem basamaklarını açıklar.\n5.7.3\nTek ve çok parçalı kalıp alma tekniklerini açıklar."},{"id":"o28","unitId":"u6","text":"5.7.4\nNegatif kalıp alma tekniğinde işlem basamaklarını uygular."},{"id":"o29","unitId":"u6","text":"5.8.1\nPozitif döküm tekniğini uygular."},{"id":"o30","unitId":"u6","text":"5.8.2\nBoyama ve patine tekniklerini uygular."},{"id":"o31","unitId":"u8","text":"6.1.1\nSeramiği tanımlar."},{"id":"o32","unitId":"u8","text":"6.1.2\nSeramik yapımında kullanılan araç gereçleri açıklar."},{"id":"o33","unitId":"u8","text":"6.2.1\nSeramik yapımında kullanılan kil yoğurma tekniklerini açıklar."},{"id":"o34","unitId":"u8","text":"6.2.2\nSeramik yapımında kullanılan şekillendirme yöntemlerini açıklar."},{"id":"o35","unitId":"u8","text":"6.2.3\nSeramik uygulaması yapar."},{"id":"o36","unitId":"u8","text":"6.3.1\nŞekillendirilen seramik çalışmasının kurutma işlemlerini yapar."},{"id":"o37","unitId":"u8","text":"6.3.2\nÇalışılan kilin türüne uygun bisküvi pişirimi yapar."},{"id":"o38","unitId":"u8","text":"6.4.1\nSeramik çalışmalarında sırlama yöntemlerini uygular."},{"id":"o39","unitId":"u8","text":"6.4.2\nSır pişirimini uygular."},{"id":"o40","unitId":"u9","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"u1","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SAAT":"8","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Etkinlik":"→ İlköğretim Haftası, Öğrenciler Günü"}},{"id":"w2","unitId":"u1","outcomeIds":["o2"],"fields":{"HAFTA":"2. Hafta:\n21-25 Eylül","AY":"EYLÜL","SAAT":"8","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{}},{"id":"w3","unitId":"u2","outcomeIds":["o3"],"fields":{"HAFTA":"3. Hafta:\n28 Eylül-02 Ekim","AY":"EYLÜL","SAAT":"8","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Etkinlik":"→ Dünya Okul Sütü Günü, Disleksi Haftası, Dünya Disleksi Günü"}},{"id":"w4","unitId":"u2","outcomeIds":["o4"],"fields":{"HAFTA":"4. Hafta:\n05-09 Ekim","AY":"EKİM","SAAT":"8","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Etkinlik":"→ Dünya Çocuk Günü"}},{"id":"w5","unitId":"u3","outcomeIds":["o5"],"fields":{"HAFTA":"5. Hafta:\n12