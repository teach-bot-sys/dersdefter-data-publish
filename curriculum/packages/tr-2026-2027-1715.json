{"id":"tr-2026-2027-1715","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1715","gradeId":"9","programId":"program-1715","metadata":{"egitim_yili":"2026-2027","sinif":"9","ders":"Çalgı Eğitimi Kanun Öğretim Programı","grup":"Kültür Dersleri","brans":"Güzel Sanatlar Lisesi","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/guzel-sanatlar-lisesi/1715/calgi-egitimi-kanun-ogretim-programi-9"},"units":[{"id":"u1","name":"KANUN ÇALMADA TEMEL DAVRANIŞLAR"},{"id":"u2","name":"TELLERDEN SES ÇIKARTMA ÇALIŞMALARI"},{"id":"u3","name":"Dönem Ara Tatili"},{"id":"u4","name":"MANDAL ÇALIŞMALARI"},{"id":"u5","name":"ÇARGAH MAKAMI"},{"id":"u6","name":"Yarıyıl Tatili"},{"id":"u7","name":"BÜSELİK MAKAMI"},{"id":"u8","name":"KÜRDİ MAKAMI"},{"id":"u9","name":"RAST MAKAMI"},{"id":"u10","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"9.1.1.1\nKanunun tarihçesini açıklar.\n9.1.1.2\nKanunun yapısal özelliklerini açıklar.\n9.1.1.3\nDoğru oturma ve çalma pozisyonunu uygular.\n9.1.1.4\nAyaklık ve nota sehpasının işlevini açıklar."},{"id":"o2","unitId":"u1","text":"9.1.1.5\nYüksük, mızrap ve akort anahtarının işlevini açıklar.\n9.1.2.1\nKanun çalgısının ses genişliğini açıklar.\n9.1.2.2\nKanun çalgısındaki natürel seslerin isimlerini söyler."},{"id":"o3","unitId":"u1","text":"9.1.2.3\nKanun çalgısındaki natürel seslerin Türk müziğindeki perde isimlerini söyler.\n9.1.3.1\nAralarında boşluk bulunmayan mandal gruplarını gösterir.\n9.1.3.2\nAralarında boşluk bulunan mandal gruplarını gösterir."},{"id":"o4","unitId":"u1","text":"9.1.4.1\nAkordun önemini açıklar.\n9.1.4.2\nAkort etme yöntemlerini açıklar.\n9.1.4.3\nKanunu akort eder."},{"id":"o5","unitId":"u2","text":"9.2.1.1\nKaba çärgah ve acem-aşiran telleri üzerinde mızrap çalışması yapar."},{"id":"o6","unitId":"u2","text":"9.2.1.2\nÇärgah ve acem telleri üzerinde mızrap çalışması yapar."},{"id":"o7","unitId":"u2","text":"9.2.1.3\nKaba çärgah ve çärgah ses sahasında basit usullerle mızrap çalışması yapar."},{"id":"o8","unitId":"u2","text":"9.2.1.4\nKaba çärgäh ve tiz çärgäh ses sahasında basit usullerle mızrap çalışması yapar."},{"id":"o9","unitId":"u2","text":"9.2.1.5\nBileşik usullerle mızrap çalışması yapar."},{"id":"o10","unitId":"u3","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u4","text":"9.3.1.1\nYegäh, hüseyni-aşiran, rast, dügäh, büselik telleri üzerinde mandal çalışması yapar."},{"id":"o12","unitId":"u4","text":"9.3.1.2\nEtüt içinde mandal çalışmaları yapar."},{"id":"o13","unitId":"u5","text":"9.4.1.1\nÇärgah makamını açıklar."},{"id":"o14","unitId":"u5","text":"9.4.1.2\nÇärgah makamındaki etütleri çalar."},{"id":"o15","unitId":"u5","text":"9.4.1.3\nÇärgah makamının seyrini çalar."},{"id":"o16","unitId":"u5","text":"9.4.1.4\nÇärgah makamında verilen örnek eserleri çalar."},{"id":"o17","unitId":"u6","text":"Yarıyıl Tatili"},{"id":"o18","unitId":"u7","text":"9.5.1.1\nBüselik makamını açıklar."},{"id":"o19","unitId":"u7","text":"9.5.1.2\nBüselik makamındaki etütleri çalar."},{"id":"o20","unitId":"u7","text":"9.5.1.3\nBüselik makamının seyrini çalar."},{"id":"o21","unitId":"u7","text":"9.5.1.4\nTremolo tekniğini uygular."},{"id":"o22","unitId":"u3","text":"2. Dönem Ara Tatili"},{"id":"o23","unitId":"u7","text":"9.5.1.5\nBüselik makamında verilen örnek eserleri çalar."},{"id":"o24","unitId":"u8","text":"9.6.1.1\nKürdi makamını açıklar."},{"id":"o25","unitId":"u8","text":"9.6.1.2\nKürdi makamındaki etütleri çalar."},{"id":"o26","unitId":"u8","text":"9.6.1.3\nKürdi makamının seyrini çalar."},{"id":"o27","unitId":"u8","text":"9.6.1.4\nKürdi makamında verilen örnek eserleri çalar."},{"id":"o28","unitId":"u9","text":"9.7.1.1\nRast makamını açıklar."},{"id":"o29","unitId":"u9","text":"9.7.1.2\nRast makamındaki etütleri çalar."},{"id":"o30","unitId":"u9","text":"9.7.1.3\nRast makamının seyrini çalar."},{"id":"o31","unitId":"u9","text":"9.7.1.4\nRast makamında verilen örnek eserleri çalar."},{"id":"o32","unitId":"u10","text":"Etkinl