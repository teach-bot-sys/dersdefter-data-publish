{"id":"tr-2026-2027-1911","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1911","gradeId":"9","programId":"program-1911","metadata":{"egitim_yili":"2026-2027","sinif":"9","ders":"Klarnet","grup":"Kültür Dersleri","brans":"Güzel Sanatlar Lisesi","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/guzel-sanatlar-lisesi/1911/klarnet-9"},"units":[{"id":"u1","name":"Klarneti Tanıyalım"},{"id":"u2","name":"Klarnet Tekniğinde Temel Uygulamalar"},{"id":"u3","name":"Dönem Ara Tatili"},{"id":"u4","name":"Klarnette Tonal Diziler ve Arpej Çalışmaları"},{"id":"u5","name":"Yarıyıl Tatili"},{"id":"u6","name":"Klarnette Tonal ve Modal Diziler"},{"id":"u7","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"9.1.1.1\nÜflemeli çalgılar ailesini açıklar.\n9.1.2.1\nKlarnetin gelişim sürecindeki yapısal değişiklikleri açıklar.\n9.1.3.1\nKlarnetin yapısal özelliklerini açıklar.\n9.1.3.2\nKlarnetin ses bölgelerini açıklar.\n9.1.3.3\nKlarnet ailesini açıklar.\n9.1.3.4\nFarklı klarnet türlerinin kullanım alanlarını açıklar.\n9.1.4.1\nKlarneti koruma tekniklerini açıklar.\n9.1.4.2\nGünlük ve yıllık bakımın önemini açıklar.\n9.1.4.3\nÇalma/monte hatalarından kaynaklanabilecek arızaları açıklar."},{"id":"o2","unitId":"u2","text":"9.2.1.1\nNefes türlerini açıklar.\n9.2.1.2\nDiyafram nefesi kullanımının farkını açıklar.\n9.2.1.3\nDoğru diyafram nefesini alır.\n9.2.1.4\nÜfleme tekniği alıştırmalarını uygular."},{"id":"o3","unitId":"u2","text":"9.2.2.1\nKlarnet parçalarının yerlerini açıklar.\n9.2.2.2\nKlarneti monte eder ve söker.\n9.2.2.3\nÇalgının düzenli temizliğinin önemini açıklar."},{"id":"o4","unitId":"u2","text":"9.2.3.1\nAğızlığı doğru yerleştirir.\n9.2.3.2\nAğız pozisyonunu bozmadan ses üretir.\n9.2.3.3\nDiyafram desteği ile temiz si bemol sesi üretir.\n9.2.4.1\nKlarneti uygun açıda tutar."},{"id":"o5","unitId":"u2","text":"9.2.4.2\nDengeli ve dik duruşu gevşek omuzlarla korur.\n9.2.4.3\nDoğru duruş ve tutuşun önemini açıklar.\n9.2.5.1\nKlarneti doğru tutar."},{"id":"o6","unitId":"u2","text":"9.2.5.2\nSol el notalarını çalar.\n9.2.5.3\nSağ el notalarını çalar.\n9.2.5.4\nSerçe parmak kullanımını gösterir.\n9.2.5.5\nHer iki serçe parmakla notaları çalar."},{"id":"o7","unitId":"u2","text":"9.2.5.6\nÖğrenilen notaları temiz çalar.\n9.2.5.7\nRegistre tuşu kullanımını gösterir.\n9.2.5.8\nSi bemol - la geçişlerini yapar."},{"id":"o8","unitId":"u2","text":"9.2.5.9\nRegistre tuşu ile öğrenilen notalarda iki ses bölgesi arasında temiz geçişler yapar.\n9.2.5.10\nKlarnette kullanılan parmak pozisyonlarını gösterir.\n9.2.5.11\nŞalümo bölgesinde 1 oktav kromatik gam çalar."},{"id":"o9","unitId":"u2","text":"9.2.5.12\nKlarino bölgesinde 1 oktav kromatik gam çalar.\n9.2.6.1\nTek notada dil kullanımını gösterir.\n9.2.6.2\nŞalümo bölgesinde temiz dil tekniği kullanır.\n9.2.6.3\nDil ve diyaframın birlikte kullanımını gösterir."},{"id":"o10","unitId":"u3","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u2","text":"9.2.6.4\nDil-diyafram alıştırmalarını yapar.\n9.2.6.5\nArtikülasyon tekniklerinin benzerlik ve farklılıklarını açıklar.\n9.2.6.6\nBu teknikleri çalar."},{"id":"o12","unitId":"u2","text":"9.2.6.7\nÖğrenilen artikülasyon tekniklerini çeşitli alıştırmalarda uygular.\n9.2.7.1\nEntonasyon ve sonorite kavramlarını açıklar.\n9.2.7.2\nKlarnetin yapısına özgü entonasyon problemlerini tanımlar.\n9.2.7.3\nPiano (p) ve forte (f) dinamiklerinde çalarken perde farklarını fark eder."},{"id":"o13","unitId":"u2","text":"9.2.7.4\nDinamiklerin entonasyona etkisini açıklar.\n9.2.7.5\nEntonasyon problemlerini düzeltir.\n9.2.7.6\nSonorite kavramını açıklar."},{"id":"o14","unitId":"u2","text":"9.2.7.7\nDiyafram desteği ile hava basıncını kontrol ederek iyi sonorite elde eder.\n9.2.7.8\nTeknik seviyeye uygun iyi sonorite ile alıştırma, etüt ve eserleri çalar.\n9.2.7.9\nTeknik seviyeye uygun iyi sonorite ile alıştırma, etüt ve eserleri çalar."},{"id":"o15","unitId":"u4","text":"9.3.1.1\nMajör gamların ton imzalarını söyler.\n9.3.1.2\nİlgili minör gamlarını tanımlar.\n9.3.1.3\nMajör gamları 1 oktav çalar."},{"id":"o16","unitId":"u4","text":"9.3.1.4\nAralıkları alıştırır.\n9.3.1.5\nArpej ve kırık arpejleri çalar.\n9.3.1.6\nGam, aralık, arpej ve kırık arpejlere artikülasyon uygular."},{"id":"o17","unitId":"u4","text":"9.3.1.7\nÖğrenilen tonlarda etüt ve eserleri çalar.\n9.3.1.8\nÖğrenilen tonlarda etüt ve eserleri çalar.\n9.3.2.1\nLa minörün ilgili majör gamını tanımlar."},{"id":"o18","unitId":"u4","text":"9.3.2.2\nLa minörün doğal, armonik ve melodik formlarını açıklar.\n9.3.2.3\nLa minörü armonik ve melodik formda 1 oktav çalar.\n9.3.2.4\nLa minörde aralıkları alıştırır."},{"id":"o19","unitId":"u4","text":"9.3.2.5\nLa minörde arpej ve kırık arpejleri çalar.\n9.3.2.6\nLa minör gam, aralık, arpej ve kırık arpejlere artikülasyon uygular.\n9.3.2.7\nLa minörde etütleri çalar."},{"id":"o20","unitId":"u5","text":"Yarıyıl Tatili"},{"id":"o21","unitId":"u6","text":"9.4.1.1\nMajör ve ilgili minör gamları 2 oktav çalar.\n9.4.1.2\n2 oktav aralıkları alıştırır."},{"id":"o22","unitId":"u6","text":"9.4.1.3\n2 oktav arpej ve kırık arpejleri çalar."},{"id":"o23","unitId":"u6","text":"9.4.1.4\nMajör ve minör gam, arpej ve kırık arpejlere çeşitli artikülasyonlar uygular."},{"id":"o24","unitId":"u6","text":"9.4.1.5\nÖğrenilen tonlarda etüt ve eserleri çalar."},{"id":"o25","unitId":"u3","text":"2. Dönem Ara Tatili"},{"id":"o26","unitId":"u6","text":"9.4.1.6\nÖğrenilen tonlarda etüt ve eserleri çalar."},{"id":"o27","unitId":"u6","text":"9.4.2.1\nModal gamları açıklar."},{"id":"o28","unitId":"u6","text":"9.4.2.2\nModal gamları adlandırır."},{"id":"o29","unitId":"u6","text":"9.4.2.3\nSeviyeye uygun modal gamları çalar."},{"id":"o30","unitId":"u6","text":"9.4.2.4\nModal eserleri çalar."},{"id":"o31","unitId":"u6","text":"9.4.3.1\nMakam gamlarını açıklar.\n9.4.3.2\nMakam gamlarında 4. ve 5. aralıkların kullanımını açıklar."},{"id":"o32","unitId":"u6","text":"9.4.3.3\nMakam türlerini adlandırır."},{"id":"o33","unitId":"u6","text":"9.4.3.4\nÇargâh makamının gamını çalar."},{"id":"o34","unitId":"u6","text":"9.4.3.5\nMahur makamının gamını çalar."},{"id":"o35","unitId":"u6","text":"9.4.3.6\nRast makamının gamını çalar."},{"id":"o36","unitId":"u6","text":"9.4.3.7\nBüselik makamının gamını çalar."},{"id":"o37","unitId":"u6","text":"9.4.3.8\nBu makamları karakteristik melodik özellikleriyle çalar."},{"id":"o38","unitId":"u6","text":"9.4.3.9\nBu makamlarda etütleri çalar."},{"id":"o39","unitId":"u6","text":"9.4.3.10\nBu makamlarda bestelenmiş eserleri çalar."},{"id":"o40","unitId":"u7","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"u1","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SAAT":"4","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"9.1.1.1\n9.1.2.1\n9.1.3.1\n9.1.3.2\n9.1.3.3\n9.1.3.4\n9.1.4.1\n9.1.4.2\n9.1.4.3","Etkinlik":"→ İlköğretim Haftası, Öğrenciler Günü"}},{"id":"w2","unitId":"u2","outcomeIds":["o2"],"fields":{"HAFTA":"2. Hafta:\n21-25 Eylül","AY":"EYLÜL","SAAT":"4","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"9.2.1.1\n9.2.1.2\n9.2.1.3\n9.2.1.4"}},{"id":"w3","unitId":"u2","outcomeIds":["o3"],"fields":{"HAFTA":"3. Hafta:\n28 Eylül-02 Ekim","AY":"EYLÜL","SAAT":"4","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"9.2.2.1\n9.2.2.2\n9.2.2.3","Etkinlik":"→ Dünya Okul Sütü Günü, Disleksi Haftası, Dünya Disleksi Günü"}},{"id":"w4","unitId":"u2","outcomeIds":["o4"],"fields":{"HAFTA":"4. Hafta:\n05-09 Ekim","AY":"EKİM","SAAT":"4","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"9.2.3.1\n9.2.3.2\n9.2.3.3\n9.2.4.1","Etkinlik":"→ Dünya Çocuk Günü"}},{"id":"w5","unitId":"u2","outcomeIds":["o5"],"fields":{"HAFTA":"5. Hafta:\n12-16 Ekim","AY":"EKİM","SAAT":"4","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields"