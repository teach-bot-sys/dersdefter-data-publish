{"id":"tr-2026-2027-1912","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1912","gradeId":"10","programId":"program-1912","metadata":{"egitim_yili":"2026-2027","sinif":"10","ders":"Klarnet","grup":"Kültür Dersleri","brans":"Güzel Sanatlar Lisesi","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/guzel-sanatlar-lisesi/1912/klarnet-10"},"units":[{"id":"u1","name":"İnce Seslerde Egzersizler"},{"id":"u2","name":"Klarnette Tonal ve Modal Diziler 1"},{"id":"u3","name":"Dönem Ara Tatili"},{"id":"u4","name":"Yarıyıl Tatili"},{"id":"u5","name":"Süsleme Notaları"},{"id":"u6","name":"Klarnette Tonal ve Modal Diziler 2"},{"id":"u7","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"10.1.1.1\nKlarnet ses bölgelerini açıklar.\n10.1.1.2\nMüzikte doğuşkan kavramını açıklar.\n10.1.1.3\nKlarnette doğuşkanların kullanımını tanımlar."},{"id":"o2","unitId":"u1","text":"10.1.1.4\nKlarnette doğuşkanların nasıl elde edildiğini gösterir.\n10.1.2.1\nİnce (aigu-altissimo) ses bölgesindeki notaları adlandırır."},{"id":"o3","unitId":"u1","text":"10.1.2.2\nİnce ses bölgesinde do diyez, re, re diyez, mi, fa notalarını çalar.\n10.1.2.3\nÖğrenilen ses bölgeleri arasında temiz geçişler yapar.\n10.1.2.4\nÖğrenilen aralıklarda entonasyon kontrolü sağlar."},{"id":"o4","unitId":"u1","text":"10.1.2.5\nÖğrenilen aralıklara farklı artikülasyon teknikleri uygular.\n10.1.2.6\nTüm öğrenilen notaları (ses bölgesi geçişleri dahil) kromatik legato pasajlarla çalar."},{"id":"o5","unitId":"u2","text":"10.2.1.1\nİki bemollü majör ve ilgili minör gamlarını 2 oktav çalar.\n10.2.1.2\nBu gamlarda 2 oktav aralıkları alıştırır."},{"id":"o6","unitId":"u2","text":"10.2.1.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar."},{"id":"o7","unitId":"u2","text":"10.2.1.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular.\n10.2.1.5\nİki bemollü gamları içeren etütleri çalar."},{"id":"o8","unitId":"u2","text":"10.2.1.6\nİki bemollü gamları içeren eserleri çalar."},{"id":"o9","unitId":"u2","text":"10.2.2.1\nİki diyezli majör ve ilgili minör gamlarını 2 oktav çalar.\n10.2.2.2\nBu gamlarda 2 oktav aralıkları alıştırır."},{"id":"o10","unitId":"u3","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u2","text":"10.2.2.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar."},{"id":"o12","unitId":"u2","text":"10.2.2.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular."},{"id":"o13","unitId":"u2","text":"10.2.2.5\nİki diyezli gamları içeren etütleri çalar.\n10.2.2.6\nİki diyezli gamları içeren eserleri çalar."},{"id":"o14","unitId":"u2","text":"10.2.3.1\nİki diyezli ve iki bemollü majör gamlarında modal gamları ve derecelerini adlandırır."},{"id":"o15","unitId":"u2","text":"10.2.3.2\nİki diyezli ve iki bemollü majör gamlarında verilen derecelere göre modal gamları adlandırır.\n10.2.3.3\nİki diyezli ve iki bemollü majör gamlarının modal gamlarını çalar."},{"id":"o16","unitId":"u2","text":"10.2.4.1\nKürdi makamının gamını çalar."},{"id":"o17","unitId":"u2","text":"10.2.4.2\nMuhayyer-Kürdi makamının gamını çalar.\n10.2.4.3\nKürdi ve Muhayyer-Kürdi makamlarını karakteristik melodik hareketleriyle çalar."},{"id":"o18","unitId":"u2","text":"10.2.4.4\nKürdi ve Muhayyer-Kürdi makamlarına ait etütleri çalar."},{"id":"o19","unitId":"u2","text":"10.2.4.5\nKürdi ve Muhayyer-Kürdi makamlarında bestelenmiş eserleri çalar."},{"id":"o20","unitId":"u4","text":"Yarıyıl Tatili"},{"id":"o21","unitId":"u5","text":"10.3.1.1\nTril, çarpma, appoggiatura, mordent ve gruppeto (dönüş) süslemelerinin ritim değerlerini açıklar."},{"id":"o22","unitId":"u5","text":"10.3.1.2\nBu süslemeleri dönemine uygun çalar."},{"id":"o23","unitId":"u5","text":"10.3.1.3\nTremolo çalmanın ritim değerini açıklar."},{"id":"o24","unitId":"u5","text":"10.3.1.4\nFarklı not değerlerinde tremolo çalar."},{"id":"o25","unitId":"u3","text":"2. Dönem Ara Tatili"},{"id":"o26","unitId":"u5","text":"10.3.1.5\nKlarnette tril tuşlarının kullanımını açıklar."},{"id":"o27","unitId":"u5","text":"10.3.1.6\nKlarnet tril tuşlarını kullanarak alıştırmalar yapar."},{"id":"o28","unitId":"u6","text":"10.4.1.1\nÜç bemollü majör ve ilgili minör gamlarını 2 oktav çalar.\n10.4.1.2\nBu gamlarda 2 oktav aralıkları alıştırır."},{"id":"o29","unitId":"u6","text":"10.4.1.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar.\n10.4.1.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular."},{"id":"o30","unitId":"u6","text":"10.4.1.5\nÜç bemollü gamları içeren etüt ve eserleri çalar.\n10.4.2.1\nÜç diyezli majör ve ilgili minör gamlarını 2 oktav çalar."},{"id":"o31","unitId":"u6","text":"10.4.2.2\nBu gamlarda 2 oktav aralıkları alıştırır."},{"id":"o32","unitId":"u6","text":"10.4.2.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar.\n10.4.2.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular."},{"id":"o33","unitId":"u6","text":"10.4.2.5\nÜç diyezli gamları içeren etüt ve eserleri çalar.\n10.4.3.1\nÜç bemollü ve üç diyezli majör gamlarında modal gamları ve derecelerini adlandırır."},{"id":"o34","unitId":"u6","text":"10.4.3.2\nÜç bemollü ve üç diyezli majör gamlarında verilen derecelere göre modal gamları adlandırır."},{"id":"o35","unitId":"u6","text":"10.4.3.3\nÜç bemollü ve üç diyezli majör gamlarının modal gamlarını çalar.\n10.4.4.1\nNihâvend makamının gamını çalar."},{"id":"o36","unitId":"u6","text":"10.4.4.2\nNihâvend makamını karakteristik özelliklerine göre çalar.\n10.4.4.3\nNihâvend makamına ait etütleri çalar."},{"id":"o37","unitId":"u6","text":"10.4.4.4\nNihâvend makamında bestelenmiş eserleri çalar."},{"id":"o38","unitId":"u7","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"u1","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"10.1.1.1\n10.1.1.2\n10.1.1.3","Etkinlik":"→ İlköğretim Haftası, Öğrenciler Günü"}},{"id":"w2","uni