{"id":"tr-2026-2027-1914","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1914","gradeId":"12","programId":"program-1914","metadata":{"egitim_yili":"2026-2027","sinif":"12","ders":"Klarnet","grup":"Kültür Dersleri","brans":"Güzel Sanatlar Lisesi","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/guzel-sanatlar-lisesi/1914/klarnet-12"},"units":[{"id":"u1","name":"İnce Seslerde Egzersizler"},{"id":"u2","name":"Klarnette Tonal ve Modal Diziler 1"},{"id":"u3","name":"Dönem Ara Tatili"},{"id":"u4","name":"Yarıyıl Tatili"},{"id":"u5","name":"Klarnet Çalmada Yeni Teknikler - Çift Dil Kullanımı"},{"id":"u6","name":"Klarnette Tonal ve Modal Diziler 2"},{"id":"u7","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"12.1.1.1\nİnce (aigu-altissimo) ses bölgesindeki notaları adlandırır.\n12.1.1.2\nİnce ses bölgesinde fa, fa diyez, sol, sol diyez, la, la diyez, si notalarını çalar."},{"id":"o2","unitId":"u1","text":"12.1.1.3\nSes bölgeleri arasında temiz geçişler yapar.\n12.1.1.4\nÖğrenilen aralıklarda entonasyon kontrolü sağlar."},{"id":"o3","unitId":"u1","text":"12.1.1.5\nÖğrenilen aralıklara farklı artikülasyon teknikleri uygular."},{"id":"o4","unitId":"u1","text":"12.1.1.6\nTüm öğrenilen notaları (ses bölgesi geçişleri dahil) kromatik legato pasajlarla çalar."},{"id":"o5","unitId":"u1","text":"12.1.1.7\nİnce ses bölgesinde çeşitli artikülasyon tekniklerini uygular."},{"id":"o6","unitId":"u2","text":"12.2.1.1\nAltı bemollü majör ve ilgili minör gamlarını 2 oktav çalar.\n12.2.1.2\nBu gamlarda 2 oktav aralıkları alıştırır.\n12.2.1.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar."},{"id":"o7","unitId":"u2","text":"12.2.1.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular.\n12.2.1.5\nAltı bemollü gamları içeren etüt ve eserleri çalar."},{"id":"o8","unitId":"u2","text":"12.2.1.6\nAltı bemollü gamları içeren etüt ve eserleri çalar.\n12.2.2.1\nAltı diyezli majör ve ilgili minör gamlarını 2 oktav çalar."},{"id":"o9","unitId":"u2","text":"12.2.2.2\nBu gamlarda 2 oktav aralıkları alıştırır.\n12.2.2.3\nBu gamların arpej ve kırık arpejlerini 2 oktav çalar."},{"id":"o10","unitId":"u3","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u2","text":"12.2.2.4\nBu gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular.\n12.2.2.5\nAltı diyezli gamları içeren etüt ve eserleri çalar."},{"id":"o12","unitId":"u2","text":"12.2.2.6\nAltı diyezli gamları içeren etüt ve eserleri çalar.\n12.2.3.1\nAltı bemollü ve altı diyezli majör gamlarında modal gamları ve derecelerini adlandırır."},{"id":"o13","unitId":"u2","text":"12.2.3.2\nAltı bemollü ve altı diyezli majör gamlarında verilen derecelere göre modal gamları adlandırır.\n12.2.3.3\nAltı bemollü ve altı diyezli majör gamlarının modal gamlarını çalar."},{"id":"o14","unitId":"u2","text":"12.2.4.1\nHüseyni makamının gamını çalar.\n12.2.4.2\nKarcığar makamının gamını çalar."},{"id":"o15","unitId":"u2","text":"12.2.4.3\nSaba makamının gamını çalar.\n12.2.4.4\nHüseyni makamını karakteristik özelliklerine göre çalar."},{"id":"o16","unitId":"u2","text":"12.2.4.5\nKarcığar makamını karakteristik özelliklerine göre çalar.\n12.2.4.6\nSaba makamını karakteristik özelliklerine göre çalar."},{"id":"o17","unitId":"u2","text":"12.2.4.7\nHüseyni makamına ait etütleri çalar.\n12.2.4.8\nKarcığar makamına ait etütleri çalar."},{"id":"o18","unitId":"u2","text":"12.2.4.9\nSaba makamına ait etütleri çalar.\n12.2.4.10\nHüseyni makamında bestelenmiş eserleri çalar."},{"id":"o19","unitId":"u2","text":"12.2.4.11\nKarcığar makamında bestelenmiş eserleri çalar.\n12.2.4.12\nSaba makamında bestelenmiş eserleri çalar."},{"id":"o20","unitId":"u4","text":"Yarıyıl Tatili"},{"id":"o21","unitId":"u5","text":"12.3.1.1\nKlarnette kullanılan mikrotonları açıklar."},{"id":"o22","unitId":"u5","text":"12.3.1.2\nKlarnette multifonik kullanımını açıklar."},{"id":"o23","unitId":"u5","text":"12.3.1.3\nKlarnette basit multifonikleri çalar."},{"id":"o24","unitId":"u5","text":"12.3.1.4\nKlarnette kullanılan flatter zunge, slap ve çift dil tekniklerini açıklar."},{"id":"o25","unitId":"u3","text":"2. Dönem Ara Tatili"},{"id":"o26","unitId":"u5","text":"12.3.1.5\nKlarnette kullanılan flatter zunge, slap ve çift dil tekniklerini uygular."},{"id":"o27","unitId":"u5","text":"12.3.1.6\nDöngüsel nefes tekniğini açıklar."},{"id":"o28","unitId":"u5","text":"12.3.1.7\nDöngüsel nefes tekniğini uygular."},{"id":"o29","unitId":"u6","text":"12.4.1.1\nTüm öğrenilen majör ve minör gamları 2 oktav çalar.\n12.4.1.2\nTüm öğrenilen majör ve ilgili minör gamlarda 2 oktav aralık alıştırmaları yapar."},{"id":"o30","unitId":"u6","text":"12.4.1.3\nTüm öğrenilen majör ve ilgili minör gamların arpej ve kırık arpejlerini 2 oktav çalar.\n12.4.1.4\nTüm öğrenilen majör ve minör gam, arpej ve kırık arpejlere farklı artikülasyon teknikleri uygular."},{"id":"o31","unitId":"u6","text":"12.4.1.5\nTüm öğrenilen gamları içeren etütleri çalar.\n12.4.1.6\nTüm öğrenilen gamları içeren eserleri çalar."},{"id":"o32","unitId":"u6","text":"12.4.2.1\nTüm öğrenilen majör gamlarda modal gamları ve derecelerini adlandırır.\n12.4.2.2\nTüm öğrenilen majör gamlarda verilen derecelere göre modal gamları adlandırır."},{"id":"o33","unitId":"u6","text":"12.4.2.3\nTüm öğrenilen majör gamların modal gamlarını çalar."},{"id":"o34","unitId":"u6","text":"12.4.3.1\nUşşak makamının gamını çalar."},{"id":"o35","unitId":"u6","text":"12.4.3.2\nKürdili-hicazkar makamının gamını çalar."},{"id":"o36","unitId":"u6","text":"12.4.3.3\nUşşak ve Kürdili-hicazkar makamlarını karakteristik özelliklerine göre çalar."},{"id":"o37","unitId":"u6","text":"12.4.3.4\nUşşak ve Kürdili-hicazkar makamlarına ait etütleri çalar."},{"id":"o38","unitId":"u6","text":"12.4.3.5\nUşşak ve Kürdili-hicazkar makamlarına ait eserleri çalar."},{"id":"o39","unitId":"u7","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"u1","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SA