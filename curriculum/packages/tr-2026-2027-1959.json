{"id":"tr-2026-2027-1959","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-1959","gradeId":"6","programId":"program-1959","metadata":{"egitim_yili":"2026-2027","sinif":"6","ders":"Oyun Ve Oyun Etkinlikleri Drama Modülü","grup":"Kültür Dersleri","brans":"Beden Eğitimi","sistem":"Maarif","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/beden-egitimi/1959/oyun-ve-oyun-etkinlikleri-drama-modulu-6"},"units":[{"id":"u1","name":"Drama Yoluyla İletişim"},{"id":"u2","name":"Duyu, Uyum ve Güven"},{"id":"u3","name":"Drama ve Oyun"},{"id":"u4","name":"Dönem Ara Tatili"},{"id":"u5","name":"Rol Oynama ve Doğaçlama"},{"id":"u6","name":"Yarıyıl Tatili"},{"id":"u7","name":"Drama ve Diğer Sanatlar"},{"id":"u8","name":"Drama ve Toplum"},{"id":"u9","name":"Drama ve Okul Dışı Öğrenme Ortamları"},{"id":"u10","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"u1","text":"1.1.1\nDrama etkinliklerine katılmaya istekli olur.\n1.1.2\nDrama etkinlikleri yoluyla kendini ve başkalarını tanıtır."},{"id":"o2","unitId":"u1","text":"1.1.3\nDrama etkinlikleri yoluyla mekânla tanışır.\n1.1.4\nDrama etkinlikleri yoluyla grup üyeleriyle tanışır."},{"id":"o3","unitId":"u1","text":"1.2.1\nDramada iletişimin önemini açıklar.\n1.2.2\nGrup üyeleriyle iletişim kurmaya ve etkileşime girmeye istekli olur."},{"id":"o4","unitId":"u1","text":"1.2.3\nİletişim ve etkileşim etkinliklerinde jest, mimik ve beden dilini kullanır."},{"id":"o5","unitId":"u2","text":"2.1.1\nDrama sürecinde duyularını etkili kullanır.\n2.1.2\nDuyuları aracılığıyla doğaçlamalar yapar."},{"id":"o6","unitId":"u2","text":"2.2.1\nDrama etkinliklerinde uyum içinde davranır.\n2.2.2\nGrup üretim sürecinde aktif rol oynar."},{"id":"o7","unitId":"u2","text":"2.2.3\nGrup etkinliklerinde iş birliği yapar.\n2.3.1\nGüven etkinliklerine aktif katılır."},{"id":"o8","unitId":"u2","text":"2.3.2\nKişiler arası güveni etkileyen olumlu ve olumsuz etmenleri ifade eden doğaçlamalar sergiler."},{"id":"o9","unitId":"u3","text":"3.1.1\nOyun ve drama yoluyla kendini ifade eder.\n3.1.2\nOyunlara katılmaya ve oyun oynamaya istekli olur."},{"id":"o10","unitId":"u4","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"u3","text":"3.1.3\nOyun içinde farklı stratejiler kullanır.\n3.1.4\nOyunda yer alan rolleri yaşamdaki rollerle ilişkilendirir."},{"id":"o12","unitId":"u3","text":"3.1.5\nOyun ve etkinliklerde iş birliği yapar.\n3.1.6\nOyun ve etkinliklerde başkalarının haklarına saygı gösterir."},{"id":"o13","unitId":"u3","text":"3.1.7\nOyun ve etkinliklerde bireysel farklılıklar konusunda hassasiyet göstermenin önemini fark eder."},{"id":"o14","unitId":"u5","text":"4.1.1\nRol oynama ve doğaçlamanın temel özelliklerini açıklar."},{"id":"o15","unitId":"u5","text":"4.1.2\nRol oynama ve doğaçlamanın drama açısından önemini kavrar."},{"id":"o16","unitId":"u5","text":"4.1.3\nCanlandırmalarını, rol oynama ve doğaçlama ilkelerine göre yapar."},{"id":"o17","unitId":"u5","text":"4.1.4\nRol oynama ve doğaçlama çalışmalarındaki dramatik anları deneyimleriyle ilişkilendirir."},{"id":"o18","unitId":"u6","text":"Yarıyıl Tatili"},{"id":"o19","unitId":"u7","text":"5.1.1\nTuluat ve meddahın özelliklerini açıklar.\n5.1.2\nTuluat ve meddahın drama ile ortak ve farklı yönlerini söyler."},{"id":"o20","unitId":"u7","text":"5.2.1\nDrama ve maske ilişkisini açıklar.\n5.2.2\nMaskeler aracılığıyla doğaçlamalar yapar."},{"id":"o21","unitId":"u7","text":"5.2.3\nDrama ile kukla ilişkisini açıklar.\n5.2.4\nKuklalarla doğaçlamalar yapar."},{"id":"o22","unitId":"u7","text":"5.3.1\nDrama ile görsel sanatların ilişkisini açıklar."},{"id":"o23","unitId":"u4","text":"2. Dönem Ara Tatili"},{"id":"o24","unitId":"u7","text":"5.3.2\nGörsel sanat ürünleri aracılığıyla doğaçlama yapar.\n5.3.3\nDoğaçlama yoluyla görsel sanat ürünleri oluşturur."},{"id":"o25","unitId":"u7","text":"5.3.4\nBeden aracılığı ile heykel formları oluşturur.\n5.3.5\nBeden aracılığı ile heykel formlarından yola çıkarak doğaçlama yapar."},{"id":"o26","unitId":"u7","text":"5.4.1\nYazınsal türler ile drama ilişkisini açıklar."},{"id":"o27","unitId":"u7","text":"5.4.2\nYazınsal türleri dramada bir araç olarak kullanır.\n5.4.3\nDoğaçlamalar aracılığıyla yazınsal metinler oluşturur."},{"id":"o28","unitId":"u7","text":"5.5.1\nDoğaçlamalarda ritimden yararlanır.\n5.5.2\nRitimli etkinliklerde bedeni ile doğaçlamalar yapar."},{"id":"o29","unitId":"u7","text":"5.5.3\nMüziğe ve ritme uygun devinimler geliştirir."},{"id":"o30","unitId":"u8","text":"6.1.1\nToplumsal yaşam durumlarından hareketle doğaçlamalar yapar."},{"id":"o31","unitId":"u8","text":"6.1.2\nToplumsal yaşam durumlarına farklı bakış açıları geliştirir."},{"id":"o32","unitId":"u8","text":"6.2.1\nToplumsal farkındalık ve duyarlılık temalarına ilişkin rol oynama ve doğaçlama çalışmalarına katılır."},{"id":"o33","unitId":"u8","text":"6.2.2\nFarkındalık ve duyarlılık temalı çalışmalardaki deneyimlerini doğaçlamalar yoluyla kurgular."},{"id":"o34","unitId":"u8","text":"6.2.3\nFarkındalık ve duyarlılık temalı çalışmalardaki deneyimlerini yaratıcı yollarla ifade eder."},{"id":"o35","unitId":"u9","text":"7.1.1\nOkul dışı mekânlardan drama ortamı şeklinde yararlanabileceğini açıklar."},{"id":"o36","unitId":"u9","text":"7.1.2\nOkul dışı mekânlarda bulunan nesneler aracılığıyla doğaçlamalar yapar."},{"id":"o37","unitId":"u10","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"u1","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"1.1.1\n1.1.2","Etkinlik":"→ İlköğretim Haftası, Öğrenciler Günü"}},{"id":"w2","unitId":"u1","outcomeIds":["o2"],"fields":{"HAFTA":"2. Hafta:\n21-25 Eylül","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Öğrenme Çıktısı Kodları":"1.1.3\n1.1.4"}},{"id":"w3","unitId":"u1","outcomeIds":["o3"],"fields":{"HAFTA":"3. Hafta:\n28 Eylül-02 Ekim","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ 