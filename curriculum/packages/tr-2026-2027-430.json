{"id":"tr-2026-2027-430","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-430","gradeId":"11","programId":"program-430","metadata":{"egitim_yili":"2026-2027","sinif":"11","ders":"Sınıf Rehberlik","grup":"Rehberlik Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/430/sinif-rehberlik-11"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Başarılı olduğu durumlarda kendini takdir eder."},{"id":"o2","unitId":"","text":"Akademik konulardaki güçlü ve geliştirilmesi gereken özelliklerini fark eder."},{"id":"o3","unitId":"","text":"Başarmak için çalışmanın gerekliliğine inanır."},{"id":"o4","unitId":"","text":"Kişilik özelliklerine ilişkin farkındalık geliştirir."},{"id":"o5","unitId":"","text":"Ergen-ebeveyn ilişkilerini değerlendirir."},{"id":"o6","unitId":"","text":"Akademik başarının önündeki engelleri fark eder."},{"id":"o7","unitId":"","text":"Akademik sorumluluklarını ertelemenin sonuçlarını fark eder."},{"id":"o8","unitId":"","text":"Yaşam değerleri ve davranışları arasında bağ kurar."},{"id":"o9","unitId":"","text":"İlgi, yetenek ve mesleki değerlerini ilişkilendirir."},{"id":"o10","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"","text":"Eğitsel etkinliklerdeki başarısızlıkların öğrenme sürecinin bir parçası olduğunu kabul eder."},{"id":"o12","unitId":"","text":"Öğrenme sürecinde deneyimlediği başarısızlıkların üstesinden gelmek için farklı çözüm yolları dener."},{"id":"o13","unitId":"","text":"Geleceğini hayal ederek başarılı yaşam amaçları oluşturur."},{"id":"o14","unitId":"","text":"Yaşam amaçlarına ulaşmak için bir eylem planı hazırlar."},{"id":"o15","unitId":"","text":"Liderlik özellikleri açısından kendini değerlendirir."},{"id":"o16","unitId":"","text":"Yerel ve küresel sorunları tartışır."},{"id":"o17","unitId":"","text":"Grup çalışmaların