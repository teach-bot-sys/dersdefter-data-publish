{"id":"tr-2026-2027-431","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-431","gradeId":"10","programId":"program-431","metadata":{"egitim_yili":"2026-2027","sinif":"10","ders":"Sınıf Rehberlik","grup":"Rehberlik Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/431/sinif-rehberlik-10"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Okul içinde ve dışında eğitsel ve sosyal etkinliklere katılmanın gelişimine katkılarını değerlendirir."},{"id":"o2","unitId":"","text":"Okul içinde veya dışında etkinliklere katılırken ilgi ve yeteneklerini dikkate alır."},{"id":"o3","unitId":"","text":"Alan/bölüm/dal/ders seçiminde ilgi, yetenek ve mesleki değerleri dikkate alır."},{"id":"o4","unitId":"","text":"Yaşamındaki karar verme sürecini etkileyen faktörleri açıklar."},{"id":"o5","unitId":"","text":"Karar verme basamaklarını kullanır."},{"id":"o6","unitId":"","text":"Öğrenme ve verimli çalışma stratejilerini açıklar."},{"id":"o7","unitId":"","text":"Hatırlamayı zorlaştıran ve unutmaya neden olan faktörleri açıklar."},{"id":"o8","unitId":"","text":"Öğrenme ve verimli çalışma stratejilerini kullanma açısından kendisini değerlendirir."},{"id":"o9","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o10","unitId":"","text":"Kısa ve uzun vadeli kariyer amaçlarını belirler."},{"id":"o11","unitId":"","text":"Akademik amaçlarıyla seçmek istediği kariyerlerin gerektirdiği akademik koşullar arasında bağ kurar."},{"id":"o12","unitId":"","text":"Beden imgesini etkileyen faktörler açısından kendini değerlendirir."},{"id":"o13","unitId":"","text":"Gelişim dönemi ile duygusal dalgalanmaları arasında bağ kurar."},{"id":"o14","unitId":"","text":"Kariyer beklentileri ile kariyer amaçlarını karşılaştırır."},{"id":"o15","unitId":"","text":"Kariyer karar verme süreçlerinde kendi görüşleri ile aile v