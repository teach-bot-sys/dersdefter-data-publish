{"id":"tr-2026-2027-434","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-434","gradeId":"7","programId":"program-434","metadata":{"egitim_yili":"2026-2027","sinif":"7","ders":"Sınıf Rehberlik","grup":"Kültür Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/434/sinif-rehberlik-7"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Yeni durumlar ve değişimlerle ilgili duygularını ifade eder."},{"id":"o2","unitId":"","text":"Zamanını etkili kullanmanın akademik gelişimine etkisini açıklar."},{"id":"o3","unitId":"","text":"Eğitsel çabanın akademik hedeflere ulaşmadaki etkisini değerlendirir."},{"id":"o4","unitId":"","text":"Akademik çalışmalarını zamanında bitirmede kararlı olur."},{"id":"o5","unitId":"","text":"Yapabildiği ve hoşlandığı etkinliklere dayalı olarak ilgi ve yeteneklerine örnekler verir."},{"id":"o6","unitId":"","text":"İlgi ve hobilerini ayırt eder."},{"id":"o7","unitId":"","text":"Akademik çalışmaları ile ilgili değişen durumlara uygun davranışlar sergiler."},{"id":"o8","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o9","unitId":"","text":"Mesleklerle ilgili bilgi kaynaklarına ulaşır."},{"id":"o10","unitId":"","text":"Her bireyin hak ve sorumlulukları olduğunu bilir."},{"id":"o11","unitId":"","text":"Kendisi için verimli öğrenme ve ders çalışma koşullarını oluşturur."},{"id":"o12","unitId":"","text":"Öğrenme etkinliklerine yönelik duygu ve düşüncelerini ifade eder."},{"id":"o13","unitId":"","text":"Arkadaşlarının olumlu özelliklerini takdir eder."},{"id":"o14","unitId":"","text":"Arkadaşlık ilişkilerinde yaşadığı sorunları yapıcı yollarla çözer."},{"id":"o15","unitId":"","text":"Derste dinleme, not alma ve soru sorma gibi teknikleri kullanır."},{"id":"o16","unitId":"","text":"Belleğini güçlendirecek stratejileri açıklar."},{"id":"o17","unitId":"","tex