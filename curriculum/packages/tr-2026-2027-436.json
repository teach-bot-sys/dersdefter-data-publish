{"id":"tr-2026-2027-436","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-436","gradeId":"5","programId":"program-436","metadata":{"egitim_yili":"2026-2027","sinif":"5","ders":"Sınıf Rehberlik","grup":"Kültür Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/436/sinif-rehberlik-5"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Okulun bölümlerini ve okulda çalışan personeli tanır."},{"id":"o2","unitId":"","text":"Okulun yakınındaki çevreyi tanır."},{"id":"o3","unitId":"","text":"Sınıf kurallarının oluşturulmasına katkı sağlar."},{"id":"o4","unitId":"","text":"Okul ve çevresinde risk oluşturabilecek durum ve ortamlara karşı kendini korur."},{"id":"o5","unitId":"","text":"*\nKimden, nereden, ne zaman ve nasıl yardım isteyebileceğini bilir."},{"id":"o6","unitId":"","text":"Okul ve sınıf kurallarına uyulmadığında ortaya çıkabilecek sonuçları tartışır."},{"id":"o7","unitId":"","text":"Okul ve sınıf kurallarına uyar."},{"id":"o8","unitId":"","text":"Okulun eğitsel imkânları hakkında bilgi edinir."},{"id":"o9","unitId":"","text":"Sanatsal ve sportif etkinliklerden hoşlandıklarını ayırt eder."},{"id":"o10","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o11","unitId":"","text":"Okul hazırlığına ilişkin sorumluluklarını üstlenir."},{"id":"o12","unitId":"","text":"Okulunun ve sınıfının bir üyesi olduğunu fark eder."},{"id":"o13","unitId":"","text":"Akademik gelişimi için amaçlar oluşturur."},{"id":"o14","unitId":"","text":"Sahip olduğu karakter güçlerini fark eder."},{"id":"o15","unitId":"","text":"Arkadaşlık kurmada karakter güçlerini kullanır."},{"id":"o16","unitId":"","text":"İyi bir dinleyici olur."},{"id":"o17","unitId":"","text":"Beden dilinin iletişimdeki önemini fark eder."},{"id":"o18","unitId":"","text":"Sanatsal ve sportif etkinliklerden başarabildiklerini ayırt eder."},{"id":"o19","unitId":"u2","text":"Yarıyıl Tatili"},{"id":"o20","unitId":"","text":"Çalışma ve üretmenin insan yaşamındaki önemini fark eder."},{"id":"o21","unitId":"","text":"Bir meslek sahibi olmanın kendisi ve toplum için önemini fark eder."},{"id":"o22","unitId":"","text":"Geleceği hayal ederek yaşam amaçları oluşturur."},{"id":"o23","unitId":"","text":"Arkadaşlık ilişkilerini sürdürme konusunda yapabileceklerini bilir."},{"id":"o24","unitId":"u1","text":"2. Dönem Ara Tatili"},{"id":"o25","unitId":"","text":"Değişen duygu durumlarını fark eder."},{"id":"o26","unitId":"","text":"Başkalarının duygu ve düşüncelerini anlamak için etkili dinleme stratejilerini kullanır."},{"id":"o27","unitId":"","text":"Başkalarının bakış açısının kendi bakış açısından farklı olabileceğini kabul eder."},{"id":"o28","unitId":"","text":"Kültürel farklılıklara duyarlı bir bakış açısı geliştir."},{"id":"o29","unitId":"","text":"Yardım etme becerilerini kullanır."},{"id":"o30","unitId":"","text":"Büyüme ve gelişme sürecinde bireysel farklılıklar olduğunu bilir."},{"id":"o31","unitId":"","text":"Büyüme ve gelişmenin yaşamın doğal bir parçası olduğunu örneklerle açıklar."},{"id":"o32","unitId":"","text":"Sanal arkadaşlığı, arkadaşlık ilişkileri kapsamında sorgular."},{"id":"o33","unitId":"","text":"Çatışmanın ve anlaşmazlıkların yaşamın bir parçası olduğunu fark eder."},{"id":"o34","unitId":"","text":"Gerektiğinde arkadaşlığını sonlandırır."},{"id":"o35","unitId":"","text":"Akademik amaçlarını gerçekleştirme konusunda kendini değerlendirir."},{"id":"o36","unitId":"","text":"Karar verme sürecini etkileyen faktörleri açıklar."},{"id":"o37","unitId":"","text":"Ders seçiminde karar verme becerisini kullanır."},{"id":"o38","unitId":"","text":"Sınıf rehberlik programı etkinliklerine/yaşantılarına ilişkin duygu ve düşüncelerini yansıtır."},{"id":"o39","unitId":"u3","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","A