{"id":"tr-2026-2027-439","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-439","gradeId":"2","programId":"program-439","metadata":{"egitim_yili":"2026-2027","sinif":"2","ders":"Sınıf Rehberlik","grup":"Rehberlik Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/439/sinif-rehberlik-2"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Okulun kendisi için önemini açıklar."},{"id":"o2","unitId":"","text":"Okul ve sınıf kurallarına uyulmadığında ortaya çıkabilecek sonuçları tartışır."},{"id":"o3","unitId":"","text":"Okul hazırlığına ilişkin sorumluluklarını üstlenir."},{"id":"o4","unitId":"","text":"Günlük yaşamda yaptığı tercihleri etkileyen faktörleri fark eder."},{"id":"o5","unitId":"","text":"Sosyal ilişkilerinde nezaket ifadeleri kullanır."},{"id":"o6","unitId":"","text":"Duyguların insan yaşamı için önemini fark eder."},{"id":"o7","unitId":"","text":"Sınıfta söz isteyerek düşüncelerini ifade etmeye istekli olur."},{"id":"o8","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o9","unitId":"","text":"Öğrenme etkinliklerine katılmaya istekli olur"},{"id":"o10","unitId":"","text":"Arkadaşlarının olumlu özelliklerini takdir eder."},{"id":"o11","unitId":"","text":"Grup çalışmalarında katılımcıları dinler."},{"id":"o12","unitId":"","text":"Bireylerin birbirinden fiziksel ve kişilik özellikleri açısından farklılığının doğal olduğunu bilir"},{"id":"o13","unitId":"","text":"*\n**Kişisel güvenliği için kişisel alanların gerekliliğini fark eder."},{"id":"o14","unitId":"","text":"Okul içinde ve dışında yapmaktan hoşlandığı etkinlikleri fark eder."},{"id":"o15","unitId":"","text":"Hata yaptığında telafi etme yollarını kullanır."},{"id":"o16","unitId":"u2","text":"Yarıyıl Tatili"},{"id":"o17","unitId":"","text":"İyilik hâli için beslenme, temizlik, uyku, dinlenme ve fiziksel egzer