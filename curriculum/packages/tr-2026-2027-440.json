{"id":"tr-2026-2027-440","schemaVersion":1,"contentVersion":"1.0.0","subjectId":"subject-440","gradeId":"1","programId":"program-440","metadata":{"egitim_yili":"2026-2027","sinif":"1","ders":"Sınıf Rehberlik","grup":"Rehberlik Dersleri","brans":"Rehberlik","sistem":"Eski Sistem","yayinevi":"","kaynak":"https://defterdoldur.com/plandetay/rehberlik/440/sinif-rehberlik-1"},"units":[{"id":"u1","name":"Dönem Ara Tatili"},{"id":"u2","name":"Yarıyıl Tatili"},{"id":"u3","name":"Etkinlik Haftası"}],"outcomes":[{"id":"o1","unitId":"","text":"Okula başlamaya ilişkin duygularını ifade eder."},{"id":"o2","unitId":"","text":"Okulun bölümlerini ve okulda çalışan personeli tanır."},{"id":"o3","unitId":"","text":"Okulun yakınındaki çevreyi tanır."},{"id":"o4","unitId":"","text":"Kuralların yaşamı kolaylaştıracağını fark eder."},{"id":"o5","unitId":"","text":"Okuldaki riskli olabilecek durum, ortam ve davranışları açıklar."},{"id":"o6","unitId":"","text":"Günlük yaşamda yaptığı tercihleri açıklar."},{"id":"o7","unitId":"","text":"Günlük yaşamda yaptığı tercihleri etkileyen faktörleri fark eder."},{"id":"o8","unitId":"","text":"Yaşamındaki rol ve sorumluluklarına örnek verir."},{"id":"o9","unitId":"u1","text":"1. Dönem Ara Tatili"},{"id":"o10","unitId":"","text":"Her çocuğun hak ve sorumluluklarının olduğunu bilir."},{"id":"o11","unitId":"","text":"Fiziksel özelliklerini söyler."},{"id":"o12","unitId":"","text":"Bireylerin birbirinden fiziksel açıdan farklılığının doğal olduğunu bilir."},{"id":"o13","unitId":"","text":"Yakın çevresindeki kişilerin mesleklerini tanır."},{"id":"o14","unitId":"","text":"Yaşadığı duyguları fark eder."},{"id":"o15","unitId":"","text":"Duyguların uygun olan ve olmayan ifade etme biçimlerini ayırt eder."},{"id":"o16","unitId":"","text":"Duyguların; beden diliyle, davranışlar ve yaşanan olaylarla ilişkisini kurar."},{"id":"o17","unitId":"","text":"Okul içinde ve dışında yapmaktan hoşlandığı etkinlikleri fark eder."},{"id":"o18","unitId":"u2","text":"Yarıyıl Tatili"},{"id":"o19","unitId":"","text":"İletişimde dinleme ve konuşma becerisini etkili bir şekilde kullanır"},{"id":"o20","unitId":"","text":"İyilik hâli (iyi hâlde olmak) için beslenme, temizlik, uyku, dinlenme ve fiziksel egzersizin önemini fark eder."},{"id":"o21","unitId":"u1","text":"2. Dönem Ara Tatili"},{"id":"o22","unitId":"","text":"Okulunun ve sınıfının bir üyesi olduğunu fark eder."},{"id":"o23","unitId":"","text":"Bireysel ve grupla çalışır."},{"id":"o24","unitId":"","text":"Sözel, görsel ve yazılı yönergeleri izler."},{"id":"o25","unitId":"","text":"Eğitsel etkinliklerde yönergeleri izler."},{"id":"o26","unitId":"","text":"Kişisel güvenliği için “Hayır!” demenin gerekliliğini açıklar."},{"id":"o27","unitId":"","text":"*\n**Kimden, nereden, ne zaman ve nasıl yardım isteyebileceğini bilir."},{"id":"o28","unitId":"","text":"Yaşadığı çevreyi korur."},{"id":"o29","unitId":"","text":"Oyun ve etkinliklerin amacının eğlenmek olduğunu fark eder."},{"id":"o30","unitId":"","text":"Eğitsel etkinliklerdeki başarısızlıkların öğrenme sürecinin bir parçası olduğunu kabul eder."},{"id":"o31","unitId":"","text":"Öğrenme sürecinde deneyimlediği başarısızlıkların üstesinden gelmek için farklı çözüm yolları dener"},{"id":"o32","unitId":"","text":"Her mesleğin toplumsal yaşama katkısı olduğunu fark eder."},{"id":"o33","unitId":"","text":"Bilişim teknolojilerinin kullanım amaçlarını fark eder."},{"id":"o34","unitId":"","text":"Sınıf rehberlik programı etkinliklerine/yaşantılarına ilişkin duygu ve düşüncelerini yansıtır."},{"id":"o35","unitId":"u3","text":"Etkinlik Haftası"}],"weeks":[{"id":"w1","unitId":"","outcomeIds":["o1"],"fields":{"HAFTA":"1. Hafta:\n14-18 Eylül","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":""},"extraFields":{"Etkinlik":"→ İlköğretim Haftası, Öğrenciler Günü"}},{"id":"w2","unitId":"","outcomeIds":["o2"],"fields":{"HAFTA":"2. Hafta:\n21-25 Eylül","AY":"EYLÜL","SAAT":"2","KONU":"","BELİRLİ GÜN VE HAFTALAR":"","SDB":"","OB":